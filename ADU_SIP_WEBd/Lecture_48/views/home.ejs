    <div id="container">
        <h1>Student Registration</h1>
        <form action="/submit" method="POST">
            <input type="text"
            name="name"
            placeholder="Enter Name"
            required>

            <input type="number"
            name="age"
            placeholder="Enter Age"
            required>

            <input type="text"
            name="branch"
            placeholder="Enter Branch"
            required>

            <input type="email"
            name="email"
            placeholder="Enter Email"
            required>

            <button>Submit</button>
        </form>
    </div>
</body>
</html>